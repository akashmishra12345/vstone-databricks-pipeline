{
  "datasets": [
    {
      "name": "078991da",
      "displayName": "Total Market Value",
      "queryLines": [
        "SELECT \r\n",
        "  CONCAT('$', ROUND(SUM(total_market_value_usd) / 1000000, 1), 'M') AS total_market_value\r\n",
        "FROM vstone_catalog.gold.agg_top_10_brands_by_spend"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "cbbe90c7",
      "displayName": "Total Listings",
      "queryLines": [
        "SELECT \r\n",
        "  SUM(total_listings) AS total_listings\r\n",
        "FROM vstone_catalog.gold.agg_top_10_brands_by_spend"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "3cadce10",
      "displayName": "Average Price",
      "queryLines": [
        "SELECT \r\n",
        "  CONCAT('$', ROUND(AVG(avg_price_usd), 0)) AS avg_price_usd\r\n",
        "FROM vstone_catalog.gold.agg_top_10_brands_by_spend"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "af9a0d7d",
      "displayName": "Brand vs Listings Count",
      "queryLines": [
        "SELECT\r\n",
        "  brand,\r\n",
        "  total_listings,\r\n",
        "  total_market_value_usd,\r\n",
        "  avg_price_usd\r\n",
        "FROM vstone_catalog.gold.agg_top_10_brands_by_spend\r\n",
        "ORDER BY total_listings DESC"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "ee31c10b",
      "displayName": "Price vs Volume per Brand",
      "queryLines": [
        "SELECT\r\n",
        "  brand,\r\n",
        "  avg_price_usd,\r\n",
        "  total_listings,\r\n",
        "  total_market_value_usd\r\n",
        "FROM vstone_catalog.gold.agg_top_10_brands_by_spend"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "9c135555",
      "displayName": "Top Cities by Inventory",
      "queryLines": [
        "SELECT\r\n",
        "  city_name,\r\n",
        "  SUM(inventory_count)         AS total_inventory,\r\n",
        "  ROUND(AVG(avg_price_usd), 0) AS avg_price_usd,\r\n",
        "  COUNT(DISTINCT fuel_type)    AS fuel_types_available\r\n",
        "FROM vstone_catalog.gold.agg_regional_market_depth\r\n",
        "WHERE city_name IS NOT NULL\r\n",
        "GROUP BY city_name\r\n",
        "ORDER BY total_inventory DESC\r\n",
        "LIMIT 15"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "91543fc7",
      "displayName": "Fuel Type Distribution by City",
      "queryLines": [
        "SELECT\r\n",
        "  city_name,\r\n",
        "  fuel_type,\r\n",
        "  SUM(inventory_count) AS inventory_count\r\n",
        "FROM vstone_catalog.gold.agg_regional_market_depth\r\n",
        "WHERE city_name IN (\r\n",
        "  SELECT city_name\r\n",
        "  FROM vstone_catalog.gold.agg_regional_market_depth\r\n",
        "  WHERE city_name IS NOT NULL\r\n",
        "  GROUP BY city_name\r\n",
        "  ORDER BY SUM(inventory_count) DESC\r\n",
        "  LIMIT 10\r\n",
        ")\r\n",
        "GROUP BY city_name, fuel_type\r\n",
        "ORDER BY inventory_count DESC"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    }
  ],
