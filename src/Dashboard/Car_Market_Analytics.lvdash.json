{
  "datasets": [
    {
      "name": "6bca1a84",
      "displayName": "top_10_brands",
      "queryLines": [
        "SELECT \r\n",
        "  brand,\r\n",
        "  total_market_value_usd,\r\n",
        "  total_listings,\r\n",
        "  avg_price_usd\r\n",
        "FROM vstone_catalog.gold.agg_top_10_brands_by_spend\r\n",
        "ORDER BY total_market_value_usd DESC"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "4111d947",
      "displayName": "Monthly Sales Trend",
      "queryLines": [
        "SELECT \r\n",
        "  month_year,\r\n",
        "  brand,\r\n",
        "  SUM(total_listings) AS total_listings,\r\n",
        "  ROUND(AVG(avg_price_usd), 0) AS avg_price_usd\r\n",
        "FROM vstone_catalog.gold.agg_monthly_sales_trend\r\n",
        "WHERE brand IN (\r\n",
        "  'toyota','bmw','honda','hyundai',\r\n",
        "  'nissan','kia','mercedes-benz','lexus','mitsubishi','лада'\r\n",
        ")\r\n",
        "GROUP BY month_year, brand\r\n",
        "ORDER BY month_year"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "5209f8e5",
      "displayName": "Market Value Growth Over Time",
      "queryLines": [
        "SELECT \r\n",
        "  month_year,\r\n",
        "  brand,\r\n",
        "  ROUND(SUM(total_revenue_usd), 0) AS monthly_revenue_usd\r\n",
        "FROM vstone_catalog.gold.agg_monthly_sales_trend\r\n",
        "WHERE brand IN (\r\n",
        "  'toyota','bmw','honda','hyundai',\r\n",
        "  'nissan','kia','mercedes-benz','lexus','mitsubishi','лада'\r\n",
        ")\r\n",
        "GROUP BY month_year, brand\r\n",
        "ORDER BY month_year"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "4ff542f6",
      "displayName": "KPI Counter Cards1",
      "queryLines": [
        "-- Total listings across all top brands\r\n",
        "SELECT SUM(total_listings) AS total_listings FROM vstone_catalog.gold.agg_top_10_brands_by_spend"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "c7618507",
      "displayName": "Total market value(kpi counter2)",
      "queryLines": [
        "-- Total market value\r\n",
        "SELECT CONCAT('$', ROUND(SUM(total_market_value_usd)/1000000, 1), 'M') AS total_market_value\r\n",
        "FROM vstone_catalog.gold.agg_top_10_brands_by_spend"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    },
    {
      "name": "4f2741c9",
      "displayName": "Avg price across top brands(kpi counter3",
      "queryLines": [
        "-- Avg price across top brands\r\n",
        "SELECT CONCAT('$', ROUND(AVG(avg_price_usd), 0)) AS avg_price_usd\r\n",
        "FROM vstone_catalog.gold.agg_top_10_brands_by_spend"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    }
  ],
